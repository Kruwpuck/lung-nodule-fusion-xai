@inproceedings{prabhavalkarHybridPETCTRadiomics2026,
  title = {A {{Hybrid PET-CT Radiomics}} and {{Deep Learning Framework}} for {{Robust Lung Nodule Malignancy Prediction}}},
  booktitle = {2026 {{World Conference}} on {{Computational Science}} and {{Technology}} ({{WcCST}})},
  author = {Prabhavalkar, Vinay Sudhir and K, Arthi},
  date = {2026-03-26},
  pages = {370--374},
  publisher = {IEEE},
  location = {Gharuan, India},
  doi = {10.1109/WcCST67302.2026.11495763},
  url = {https://ieeexplore.ieee.org/document/11495763/},
  urldate = {2026-07-12},
  abstract = {In regard to the diagnosis of lung cancer, early and accurate differentiation of lung nodules is critical to forming a clinical verdict, especially concerning the need to distinguish between benign and malignant cases. This study proposes a hybrid PET–CT malignancy prediction framework that combines handcrafted radiomics with deep volumetric features to capture both metabolic and structural characteristics of pulmonary nodules. PET–CT volumes are pre-processed, coregistered and segmented to extract radiomics descriptors, including SUV-based metabolic measures, CT texture features and morphological attributes. A hybrid deep architecture using 3D CNN and Transformer branches learns hierarchical volumetric representations, which are fused with radiomics features for final classification. The proposed hybrid model achieved 95\% accuracy, with 95\% sensitivity and 94\% specificity, outperforming other approaches. In comparison, the CT-only model achieved 80\% accuracy, the radiomics model 87\%, and the deep learning model 91\%. Feature importance analysis shows that deep volumetric features contributed most (0.35), followed by PET metabolic features (0.30), CT texture features (0.20) and CT shape descriptors (0.15). These results demonstrate that integrating radiomics with deep representations improves PET–CT-based lung nodule malignancy prediction.},
  eventtitle = {2026 {{World Conference}} on {{Computational Science}} and {{Technology}} ({{WcCST}})},
  isbn = {979-8-3315-9966-9},
  langid = {english},
  file = {/home/habb/Zotero/storage/8L2T2L2C/Prabhavalkar and K - 2026 - A Hybrid PET-CT Radiomics and Deep Learning Framework for Robust Lung Nodule Malignancy Prediction.pdf}
}
